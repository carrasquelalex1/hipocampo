[Unit]
Description=Hipocampo — Ciclo Glinfático Nocturno (pasada ligera con gate de actividad)
Documentation=file:///home/alex/.hipocampo/repo/scripts/hipocampo_glymphatic.py
After=network.target postgresql.service
# No compite con la limpieza profunda semanal (domingos 03:00)
After=hipocampo-maintenance.service

[Service]
Type=oneshot
Environment=HIPOCAMPO_GLYMPH_ACTIVITY_HOURS=24
ExecStart=%h/.hipocampo/scripts/run_glymphatic.sh --apply --quiet
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300

[Install]
WantedBy=timers.target
