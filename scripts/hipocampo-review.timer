[Unit]
Description=Timer para Revisión de Reglas Automáticas (cada 72h)

[Timer]
# Cada 3 días a las 04:00 AM, 1 hora después del mantenimiento semanal
OnCalendar=*-*-* 04:00:00/3
# CLAVE: si la PC estaba apagada, systemd ejecuta apenas enciende (catch-up)
Persistent=true
# Retardo aleatorio de hasta 5 min para no competir con otros timers
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
