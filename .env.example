# === Credenciales PostgreSQL (conexión local por socket Unix) ===
DB_NAME=hipocampo_db
DB_USER=tu_usuario_postgres
DB_PASSWORD=
DB_HOST=/var/run/postgresql

# === API NVIDIA NIM (para embeddings, REQUERIDO para MCP) ===
# Obtener en: https://build.nvidia.com/
NVIDIA_API_KEY=tu_nvidia_api_key

# === API OpenAI (opcional, para compatibilidad) ===
OPENAI_API_KEY=sk-TuClaveAqui

# === Rutas (opcional, mm_brain_tool.py) ===
# BRAIN_PATH=/home/usuario/.gemini/brain/knowledge_base.mm
# CACHE_PATH=/home/usuario/.gemini/brain/.mm_cache.json
