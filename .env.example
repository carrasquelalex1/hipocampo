# === Credenciales PostgreSQL (conexión local por socket Unix) ===
DB_NAME=hipocampo_db
DB_USER=tu_usuario_postgres
DB_PASSWORD=
DB_HOST=/var/run/postgresql

# === API NVIDIA NIM (para embeddings, REQUERIDO para MCP) ===
# Obtener en: https://build.nvidia.com/
NVIDIA_API_KEY=tu_nvidia_api_key

# === API OpenAI (opcional, para compatibilidad) ===
# OPENAI_API_KEY=<tu-clave-openai>

# === Embeddings locales Ollama (alternativa/complemento a NVIDIA) ===
# EMBED_BASE_URL=http://127.0.0.1:11434/v1
# EMBED_MODEL=qwen3-embedding:0.6b

# === TypeSafe System One (opcional, juicio semántico Tier 1) ===
# Key en archivo (~/.config/typesafe/api_key, chmod 600) o en variable.
# HIPOCAMPO_TYPESAFE=1
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_TIMEOUT=10

# === classifier.dev (opcional, juicio semántico Tier 2, sin key) ===
# Se usa solo cuando TypeSafe no da veredicto. 1 = activo (default).
# HIPOCAMPO_CLASSIFIER=1
# CLASSIFIER_API_URL=https://classifier.dev/
# CLASSIFIER_TIMEOUT=10

# === Rutas (opcional, mm_brain_tool.py) ===
# BRAIN_PATH=/home/usuario/.gemini/brain/knowledge_base.mm
# CACHE_PATH=/home/usuario/.gemini/brain/.mm_cache.json
